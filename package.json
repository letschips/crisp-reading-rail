{
  "name": "crisp-reading-rail",
  "version": "0.4.0",
  "description": "A compact reading-progress and heading navigation rail for Obsidian Markdown Reading view.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "test": "vitest run",
    "lint": "eslint src tests scripts *.ts *.mjs --no-error-on-unmatched-pattern",
    "check": "npm run test && npm run lint && npm run build"
  },
  "keywords": [
    "obsidian",
    "outline",
    "reading-progress"
  ],
  "author": "小红书 letschips",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
